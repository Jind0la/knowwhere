# KnowWhere Railway Deployment
# Set these in Railway dashboard → Variables (or via railway.toml)

# === Embedding Provider ===
KNOWWHERE_EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=<dein-voyage-key>

# === Optional: LLM Summarizer (DeepSeek) ===
DEEPSEEK_API_KEY=<dein-deepseek-key>

# === Auth ===
KNOWWHERE_API_KEY=<generier-ein-starkes-password>

# === Storage ===
# MemoryStore (JSON-File) — kein Postgres nötig für den Start
# DATABASE_URL nicht setzen → fällt zurück auf MemoryStore
KNOWWHERE_DATA_DIR=./data

# === Logging ===
RUST_LOG=info

# === Dream Pipeline (deaktiviert für schnellen Start) ===
DREAM_ENABLED=false

# Railway setzt PORT automatisch — unser Code liest $PORT
