# =============================================================================
# KnowWhere v0.6.0 — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# For Docker: docker compose up --build
# For Native: source .env && cargo run
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — API Authentication
# -----------------------------------------------------------------------------
# Set at server startup; used as Bearer token for all protected routes.
# If unset, auth is DISABLED and all routes are public.
KNOWWHERE_API_KEY=kw_adm...2024

# -----------------------------------------------------------------------------
# REQUIRED — Ollama (local embeddings + consolidation)
# -----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434

# Embedding model (768-dim, 8192 context)
OLLAMA_MODEL=nomic-embed-text

# Consolidation model for L0→L1→L2 fractal compaction
OLLAMA_SUMMARIZER_MODEL=qwen2.5:3b

# -----------------------------------------------------------------------------
# Optional — Server
# -----------------------------------------------------------------------------
# KNOWWHERE_PORT=3737           # default: 3737
# RUST_LOG=info                 # debug, info, warn, error

# -----------------------------------------------------------------------------
# Optional — PostgreSQL (enables postgres-storage features)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:password@localhost:5433/kw

# -----------------------------------------------------------------------------
# Optional — Retrieval Tuning
# -----------------------------------------------------------------------------
# KNOWWHERE_TEMPORAL_WEIGHT=0.5       # 0.0 = pure semantic, 0.8 = heavy recency
# KNOWWHERE_SOURCE_TYPE_WEIGHTS='{"real":1.0,"synthetic":0.85,"derived":0.70,"unknown":0.95}'
# KNOWWHERE_SOURCE_TYPE_WEIGHTS_FILE=./source_weights.json

# -----------------------------------------------------------------------------
# Optional — Cross-Encoder Reranking (requires gte-modernbert ONNX model)
# -----------------------------------------------------------------------------
# Set KNOWWHERE_RERANKER_MODEL to the ONNX model path
# Default: looks for gte-modernbert in models/ directory

# -----------------------------------------------------------------------------
# Optional — Frigate NVR Integration
# -----------------------------------------------------------------------------
# FRIGATE_URL=http://your-frigate-host:5000
# FRIGATE_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Optional — Home Assistant Integration
# -----------------------------------------------------------------------------
# HASS_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Optional — Dream Mode Scheduler
# -----------------------------------------------------------------------------
# DREAM_ENABLED=true
# DREAM_CONSOLIDATION_INTERVAL_MS=60000
# KNOWWHERE_CONSOLIDATION_MIN_CONTENT_LEN=100
