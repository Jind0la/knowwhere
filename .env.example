# KnowWhere Environment Configuration
# Copy to .env and fill in your values

# API Authentication
KNOWWHERE_API_KEY=your-api-key-here

# Ollama (local embeddings)
OLLAMA_API_URL=http://localhost:11434

# OpenAI (optional, for openai-provider feature)
OPENAI_API_KEY=

# Database (for postgres-storage feature)
# Standard: postgresql://postgres:kw@localhost:5433/kw
# Docker Compose: postgresql://postgres:kw@kw-postgres:5432/kw
DATABASE_URL=postgresql://postgres:kw@localhost:5433/kw
