# =============================================================================
# KnowWhere Environment Configuration
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# For Docker: docker compose up --build
#   All values below are passed via docker-compose.yml environment section.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for beta access
# Leave empty to disable auth (dev mode only — NOT for beta testers)
# -----------------------------------------------------------------------------
# Set at server startup; also used as the admin Bearer token for /auth/login.
# If unset, auth is DISABLED and all routes are public.
KNOWWHERE_API_KEY=

# -----------------------------------------------------------------------------
# Ollama (local embeddings — REQUIRED)
# -----------------------------------------------------------------------------
# The Ollama API URL. If Ollama runs on your host:
#   - macOS/Windows (Docker Desktop): http://host.docker.internal:11434
#   - Linux: http://172.17.0.1:11434 (or add --add-host=host.docker.internal:host-gateway)
#   - Local no-Docker dev: http://localhost:11434
OLLAMA_API_URL=http://localhost:11434

# Embedding model (text → vector). Must be available in Ollama.
# Recommended: snowflake-arctic-embed2 (multilingual: EN, DE, FR, ES, IT, 384-dim)
# Alternative: nomic-embed-text-v2-moe (English-only, 768-dim)
OLLAMA_MODEL=snowflake-arctic-embed2

# VLM model for summarization (chat model, e.g., llama3.2, mistral).
# This is DIFFERENT from the embedding model.
# Note: OLLAMA_VLM_MODEL is optional — KnowWhere works without it (no summarization).
OLLAMA_VLM_MODEL=llama3.2

# -----------------------------------------------------------------------------
# PostgreSQL (optional — enables postgres-storage features)
# -----------------------------------------------------------------------------
# Format: postgresql://postgres:<password>@<host>:<port>/<db>
# Docker Compose (from this repo): postgresql://postgres:kw@kw-postgres:5432/kw
# Local development: postgresql://postgres:***@localhost:5433/kw
DATABASE_URL=postgresql://postgres:kw@localhost:5433/kw

# Password for the kw-postgres service (docker-compose.yml)
# Change this for beta deployments!
POSTGRES_PASSWORD=kw

# -----------------------------------------------------------------------------
# Optional: External embedding providers
# -----------------------------------------------------------------------------
# If neither is set, Ollama (above) is used.
# Uncomment only ONE:

# OPENAI_API_KEY=sk-...
# GROK_API_KEY=xai-...

# -----------------------------------------------------------------------------
# Optional: Frigate NVR integration
# -----------------------------------------------------------------------------
# FRIGATE_URL=http://your-frigate-host:5000
# FRIGATE_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# Optional: Rate limiting (enable when behind a reverse proxy)
# -----------------------------------------------------------------------------
# Uncomment to enable per-IP rate limiting via axum-governor.
# Requires a proxy that sets X-Forwarded-For or X-Real-IP headers.
# RATE_LIMIT=1

# -----------------------------------------------------------------------------
# Optional: Server port (default: 3737)
# -----------------------------------------------------------------------------
# KNOWWHERE_PORT=3737

# -----------------------------------------------------------------------------
# Optional: Data directory for JSON persistence (no DATABASE_URL)
# -----------------------------------------------------------------------------
# KNOWWHERE_DATA_DIR=./data
