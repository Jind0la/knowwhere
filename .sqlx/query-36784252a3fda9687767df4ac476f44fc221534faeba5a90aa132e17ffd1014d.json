  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id as \"id!\",\n                memory_type as \"memory_type!\",\n                content,\n                embedding as \"embedding: _\",\n                importance as \"importance: _\",\n                confidence as \"confidence: _\",\n                sensitivity,\n                status,\n                access_count as \"access_count!\",\n                created_at as \"created_at!\",\n                updated_at as \"updated_at!\",\n                namespace_id,\n                parent_tier_id,\n                context_tier::text AS context_tier,\n                energy::float4 as energy,\n                content_hash,\n                semantic_thumbnail,\n                provenance,\n                entities,\n                COALESCE(tags, ARRAY[]::TEXT[]) as tags,\n                source,\n                source_id\n            FROM memories\n            WHERE namespace_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2\n            ",
