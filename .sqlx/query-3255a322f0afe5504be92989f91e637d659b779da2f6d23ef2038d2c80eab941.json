{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, energy::integer as energy, last_energy_update, memory_type, COALESCE(content, '') as content\n            FROM memories\n            WHERE status = 'active'\n              AND energy < $1\n              AND energy >= 0\n            ORDER BY energy ASC, last_energy_update ASC\n            LIMIT $2\n            ",
